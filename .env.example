# Canonical production URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://faithconnectcommunity.co.za

# Faith Connect Community NPC donations. Use its Yoco TEST key first, then its LIVE key.
# Never prefix secret keys with NEXT_PUBLIC_.
YOCO_FAITH_CONNECT_SECRET_KEY=

# Mlu Solutions digital product sales. This account receives book and music sales,
# separately from Faith Connect Community NPC donations.
YOCO_MLU_SOLUTIONS_SECRET_KEY=

# Optional public EFT details. Leave blank to show the contact-for-details message.
NEXT_PUBLIC_EFT_ACCOUNT_NAME=Faith Connect Community NPC
NEXT_PUBLIC_EFT_BANK_NAME=
NEXT_PUBLIC_EFT_ACCOUNT_NUMBER=
NEXT_PUBLIC_EFT_BRANCH_CODE=